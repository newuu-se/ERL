# This repo is ONLY the RL layer: rl/, requirements.txt, README.md, AGENTS.md, LICENSE.
# Nothing else belongs in version control. See README.md for what lives where.

# ---------------------------------------------------------------------------
# External checkouts — referenced at runtime, never vendored.
# Resolved by rl/train_env.py through NTS_SIMULATOR_DIR / NTS_DATA_DIR,
# defaulting to siblings of this repo (../NeTrainSim-adjusted, ../data).
# Guarded so an accidental in-repo clone can never be committed.
# ---------------------------------------------------------------------------
/data/
/NeTrainSim-adjusted/
/train-routes/

# Third-party reference docs that were once vendored here. Do not re-add.
/gymnasium-docs/
/tianshou-docs/

# The paper, its figures and the archive-era experiment log. Removed on purpose.
/latex/

# Route and consist data always comes from the data checkout.
*.dat

# ---------------------------------------------------------------------------
# Generated at runtime — regenerate, never commit.
# ---------------------------------------------------------------------------
# training snapshots (large)
checkpoints/
# training / evaluation logs — make_plots.py reads these
logs/
# baselines, profiles and plots, all written by rl/*.py
/results/
*.log

# ---------------------------------------------------------------------------
# Local environment
# ---------------------------------------------------------------------------
venv/
.venv/
env/
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
.continues-handoff.md
log.txt
.DS_Store
